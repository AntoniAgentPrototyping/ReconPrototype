# Copy OUTSIDE this tree — the repo is OneDrive-synced, so a real .env here
# syncs database and object-store credentials to a cloud tenant (C13). Put it
# at %LOCALAPPDATA%/recon-deploy/.env and start the stack with:
#
#   docker compose --env-file "$LOCALAPPDATA/recon-deploy/.env" up --build
#
# deploy/.env still works mechanically and is still gitignored, but gitignore
# does not stop OneDrive. Keep only this example in the tree.

# No default in the compose file: a default database password is the kind of
# thing that reaches production once and stays for years.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=recon
POSTGRES_DB=recon

# -- Object storage ---------------------------------------------------------
#
# Uploaded exports and finished workbooks live in MinIO, not on a volume. That is
# not a preference: api and worker are separate containers, the worker writes the
# workbook bytes and the api serves them, and the target deployment allows "a
# single volume" per service with no cross-service mounting — so a shared
# filesystem is not expressible there (docs/06-DECISIONS.md#d43).
#
# ROOT credentials, used only by the one-shot minio-init to create the buckets.
MINIO_ROOT_USER=recon-root
MINIO_ROOT_PASSWORD=change-me-too

# The SCOPED service account the api and the worker actually use. Separate from
# the root pair on purpose: an application holding root credentials can delete the
# bucket holding every workbook the team has invoiced from.
RECON_S3_ACCESS_KEY=recon-app
RECON_S3_SECRET_KEY=change-me-as-well

# How long raw uploads survive. A bucket LIFECYCLE rule, applied by minio-init —
# the retention promise docs/04-DATA-FLOW.md has always made and, until M6, had no
# mechanism for. An application-side deletion loop can silently stop running; a
# lifecycle rule cannot. Artifacts are never expired.
UPLOAD_RETENTION_DAYS=30

# -- The team-owned master --------------------------------------------------
#
# Directory holding "Lib & VAT rate.xlsb". Mounted read-only, not baked into the
# image (docs/06-DECISIONS.md#d8). How a server obtains this file is an unresolved
# standing risk, not a solved problem.
RECON_MASTERS_DIR=./masters

# RECON_INPUT_DIR is GONE. There is no input mount: exports arrive through the
# browser, are stripped at the upload boundary, and are stored in the
# recon-uploads bucket; the worker materialises each window into its own scratch
# directory at run time (service/materialize.py). The mount that used to be here
# was also the vector for the .dockerignore trap — a copy under deploy/ sat inside
# the build context compose sends to the daemon.
